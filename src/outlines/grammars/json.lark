?start: value

?value: object
| array
| STRING
| NUMBER             -> number
| "true"             -> true
| "false"            -> false
| "null"             -> null

array  : "[" [value ("," value)*] "]"
object : "{" [pair ("," pair)*] "}"
pair   : STRING ":" value

// Strings and numbers as defined by RFC 8259: the `common` terminals
// `ESCAPED_STRING` and `SIGNED_NUMBER` also accept invalid JSON such as
// `"\q"`, `.5`, `1.`, `+1` or `01`.
STRING: /"([^"\\\x00-\x1F]|\\(["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/
NUMBER: /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/

%import common.WS

%ignore WS
